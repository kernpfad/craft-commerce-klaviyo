        {{ forms.textField({
            label: "Inventory reporting threshold"|t('commerce-klaviyo'),
            instructions: "Optional. When set to a positive number N, tracked variants only send their real stock to Klaviyo once quantity is at or below N. Above N, Klaviyo receives a high placeholder quantity instead — so low-inventory and back-in-stock logic ignore high-stock noise. Leave empty to always send the real stock. Untracked variants are unaffected (they always report as plentifully in stock)."|t('commerce-klaviyo'),
