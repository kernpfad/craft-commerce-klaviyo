    {% js %}
    (function () {
        const root = document.getElementById({{ 'commerce-klaviyo-settings'|namespaceInputId|json_encode|raw }});
        if (!root) return;

        const tabs = Array.from(root.querySelectorAll(':scope > .pane-tabs [data-tab-id]'));
        const panels = Array.from(root.querySelectorAll(':scope > [data-tab-panel]'));

        function select(tabId) {
            if (!panels.some((panel) => panel.dataset.tabPanel === tabId)) return;

            tabs.forEach((tab) => {
                const selected = tab.dataset.tabId === tabId;
                tab.classList.toggle('sel', selected);
                tab.setAttribute('aria-selected', selected ? 'true' : 'false');
            });
            panels.forEach((panel) => {
                panel.classList.toggle('hidden', panel.dataset.tabPanel !== tabId);
            });
        }

        tabs.forEach((tab) => {
            tab.addEventListener('click', (event) => {
                event.preventDefault();
                select(tab.dataset.tabId);
                history.replaceState(null, '', '#' + tab.dataset.tabId);
            });
        });

        // Deep link (e.g. a bookmark to #catalogSync) wins; otherwise land on
        // whichever tab is currently flagging an error, so a sync failure is
        // never silently sitting behind an unselected tab.
        const errorTab = tabs.find((tab) => tab.classList.contains('error'));
        const initial = (location.hash || '').slice(1) || errorTab?.dataset.tabId || tabs[0]?.dataset.tabId;

        if (initial) select(initial);
    })();
    {% endjs %}
